{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "types": ["@cloudflare/workers-types"],
    "strict": true,
    "noEmit": true,
    // The core imports siblings with explicit .ts extensions so the SAME
    // files run under Deno (Supabase Edge Functions); allow that for tsc /
    // the Worker build too.
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/**/*.ts"],
  // The Deno edge-function entry uses Deno globals tsc can't see; it is
  // typechecked by `deno check`, not by this config.
  "exclude": ["node_modules", "dist", "src/edge-function"]
}
